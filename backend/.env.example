# ============================================================
# ランタイム接続（FastAPIアプリが実際にクエリを発行する接続）
# 必ず db/setup_rls.sql の手順で作成した app_user（NOBYPASSRLS）を使うこと。
# SupabaseのService Role接続文字列はRLSを素通りするため絶対に使わない。
# ============================================================
DB_USER=app_user
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres

# ============================================================
# マイグレーション専用接続（alembicがCREATE TABLE / ENABLE RLS / CREATE POLICY を
# 実行するための接続）。app_userはDDL権限を持たないため、
# Supabaseのデフォルト接続ロール（postgres、テーブルオーナー権限あり）を指定する。
# 本番運用でこの接続情報をアプリのランタイムに使い回さないこと。
# ============================================================
MIGRATION_DB_USER=postgres
MIGRATION_DB_PASSWORD=
MIGRATION_DB_HOST=
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=postgres

# ============================================================
# JWT設定
# ============================================================
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ============================================================
# CORS（フロントエンドのオリジンのみ許可）
# ============================================================
FRONTEND_ORIGIN=http://localhost:5173

# ============================================================
# Claude API（AI予想機能で使用。フロントエンドには一切露出させない）
# ============================================================
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
